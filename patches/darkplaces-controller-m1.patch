diff --git a/joy_sdl.c b/joy_sdl.c
new file mode 100644
index 0000000000000000000000000000000000000000..faa46558b8194476491eef154843753128fd26ca
--- /dev/null
+++ b/joy_sdl.c
@@ -0,0 +1,101 @@
+/* SDL-only controller ownership and polling. GPL-2.0-or-later. */
+#include "joy_sdl.h"
+
+void JoySDL_Close(joy_sdl_device_t *device)
+{
+	/* A controller owns its underlying joystick: never close both handles. */
+	if (device->controller)
+		SDL_GameControllerClose(device->controller);
+	else if (device->joystick)
+		SDL_JoystickClose(device->joystick);
+
+	device->controller = NULL;
+	device->joystick = NULL;
+	device->instance = -1;
+}
+
+SDL_bool JoySDL_Select(joy_sdl_device_t *device, int index)
+{
+	SDL_JoystickID instance = index >= 0 && index < SDL_NumJoysticks()
+		? SDL_JoystickGetDeviceInstanceID(index) : -1;
+	if (device->joystick && SDL_JoystickGetAttached(device->joystick)
+		&& instance == device->instance)
+		return SDL_FALSE;
+	if (!device->joystick && instance < 0)
+		return SDL_FALSE;
+
+	JoySDL_Close(device);
+	if (instance >= 0)
+	{
+		if (SDL_IsGameController(index))
+		{
+			device->controller = SDL_GameControllerOpen(index);
+			if (device->controller)
+				device->joystick = SDL_GameControllerGetJoystick(device->controller);
+		}
+		else
+			device->joystick = SDL_JoystickOpen(index);
+		if (device->joystick)
+			device->instance = SDL_JoystickInstanceID(device->joystick);
+	}
+	return SDL_TRUE;
+}
+
+static float JoySDL_Axis(Sint16 value)
+{
+	/* Both endpoints must normalize exactly, including -32768. */
+	return value < 0 ? value / 32768.0f : value / 32767.0f;
+}
+
+void JoySDL_Poll(const joy_sdl_device_t *device, joy_sdl_state_t *state, float trigger_deadzone)
+{
+	int j, count;
+	SDL_zero(*state);
+	/* A removal can arrive after selection but before this frame's poll.
+	 * Keep the old layout on the zero state so held X360 keys are released
+	 * as X360 keys, not accidentally as generic JOY/AUX keys. */
+	state->mapped = device->controller ? SDL_TRUE : SDL_FALSE;
+	if (!device->joystick || !SDL_JoystickGetAttached(device->joystick))
+		return;
+	if (device->controller)
+	{
+		/* Fixed X360_* logical order, independent of SDL enum sizes/versions. */
+		static const SDL_GameControllerButton buttons[] = {
+			SDL_CONTROLLER_BUTTON_DPAD_UP, SDL_CONTROLLER_BUTTON_DPAD_DOWN,
+			SDL_CONTROLLER_BUTTON_DPAD_LEFT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT,
+			SDL_CONTROLLER_BUTTON_START, SDL_CONTROLLER_BUTTON_BACK,
+			SDL_CONTROLLER_BUTTON_LEFTSTICK, SDL_CONTROLLER_BUTTON_RIGHTSTICK,
+			SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER,
+			SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_B,
+			SDL_CONTROLLER_BUTTON_X, SDL_CONTROLLER_BUTTON_Y
+		};
+		for (j = 0; j < SDL_CONTROLLER_AXIS_MAX && j < 6 && j < JOY_SDL_AXES; ++j)
+			state->axis[j] = JoySDL_Axis(SDL_GameControllerGetAxis(device->controller, (SDL_GameControllerAxis)j));
+		/* XInput-compatible stick coordinates: positive Y points up. */
+		state->axis[1] = -state->axis[1];
+		state->axis[3] = -state->axis[3];
+		for (j = 0; j < (int)SDL_arraysize(buttons); ++j)
+			state->button[j] = SDL_GameControllerGetButton(device->controller, buttons[j]);
+		trigger_deadzone = SDL_clamp(trigger_deadzone, 0.0f, 1.0f);
+		/* Keep both analog axes; digital firing is a separate threshold. */
+		state->button[14] = state->axis[4] > trigger_deadzone;
+		state->button[15] = state->axis[5] > trigger_deadzone;
+		state->button[16] = state->axis[1] < -0.5f;
+		state->button[17] = state->axis[1] >  0.5f;
+		state->button[18] = state->axis[0] < -0.5f;
+		state->button[19] = state->axis[0] >  0.5f;
+		state->button[20] = state->axis[3] < -0.5f;
+		state->button[21] = state->axis[3] >  0.5f;
+		state->button[22] = state->axis[2] < -0.5f;
+		state->button[23] = state->axis[2] >  0.5f;
+	}
+	else
+	{
+		count = SDL_JoystickNumAxes(device->joystick);
+		for (j = 0; j < count && j < JOY_SDL_AXES; ++j)
+			state->axis[j] = JoySDL_Axis(SDL_JoystickGetAxis(device->joystick, j));
+		count = SDL_JoystickNumButtons(device->joystick);
+		for (j = 0; j < count && j < JOY_SDL_BUTTONS; ++j)
+			state->button[j] = SDL_JoystickGetButton(device->joystick, j);
+	}
+}
diff --git a/joy_sdl.h b/joy_sdl.h
new file mode 100644
index 0000000000000000000000000000000000000000..06168f2381796cb06a7a3a14fd5aebf006334dae
--- /dev/null
+++ b/joy_sdl.h
@@ -0,0 +1,27 @@
+/* SDL-only controller ownership and polling. GPL-2.0-or-later. */
+#ifndef JOY_SDL_H
+#define JOY_SDL_H
+#include <SDL.h>
+
+#define JOY_SDL_AXES 16
+#define JOY_SDL_BUTTONS 36
+
+typedef struct joy_sdl_device_s
+{
+	SDL_Joystick *joystick;
+	SDL_GameController *controller;
+	SDL_JoystickID instance;
+} joy_sdl_device_t;
+
+typedef struct joy_sdl_state_s
+{
+	float axis[JOY_SDL_AXES];
+	unsigned char button[JOY_SDL_BUTTONS];
+	SDL_bool mapped;
+} joy_sdl_state_t;
+
+/* Returns true whenever ownership changes, including disconnect/disable. */
+SDL_bool JoySDL_Select(joy_sdl_device_t *device, int index);
+void JoySDL_Close(joy_sdl_device_t *device);
+void JoySDL_Poll(const joy_sdl_device_t *device, joy_sdl_state_t *state, float trigger_deadzone);
+#endif
